# PostgreSQL connection string for Neon.
DATABASE_URL=postgresql://user:password@example.neon.tech/job_seeker?sslmode=require

# Claude (Claude Platform on AWS) credentials used by the shared LLM client.
# The model, token prices, max tokens, and timeout live in the settings table.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://aws-external-anthropic.us-east-1.api.aws
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_WORKSPACE_HEADER=anthropic-workspace-id

# Optional LinkedIn alert-email ingestion credentials.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
IMAP_HOST=
IMAP_USERNAME=
IMAP_PASSWORD=

# Optional notification credentials.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NTFY_URL=
NTFY_TOKEN=

# Dashboard HTTP Basic credentials (required to start the dashboard).
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
